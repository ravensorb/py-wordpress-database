# Variables for local `act` runs. Committed deliberately: every difference
# between a local run and a CI run is expressed as an input here rather than as
# `if: env.ACT` branching, so both use one code path.
#
# LOCAL_ACT gates the steps act genuinely cannot perform. env.ACT is not used:
# it does not work in a job-level `if:`, and Gitea's runners also set ACT=true.
LOCAL_ACT=1

# DB_HOST is deliberately NOT set to the service label here. The shared
# context's trap 3 says services resolve by label under act, but that holds
# only when the job container joins a user-defined docker network. This
# ~/.actrc produces a job container with network="host" (visible in act's
# `docker create ... network="host"` line), so the service's published port
# appears on 127.0.0.1 and the label `db` does not resolve at all --
# "Temporary failure in name resolution". Verified by running it both ways.
#
# So the workflow's own default of 127.0.0.1 is correct here, and leaving
# DB_HOST unset is the fix. Re-check if act's networking or ~/.actrc changes.
